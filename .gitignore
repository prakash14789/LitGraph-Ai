# Secrets
.env
*.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Data (uploaded PDFs, processed artifacts, DB volumes)
data/*
!data/uploads/.gitkeep
!data/processed/.gitkeep

# Local DB dumps from the cloud migration (postgres/neo4j/chroma) — large,
# not source, kept locally as the migration's own safety net instead.
data_backups/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Eval results (generated)
tests/eval/eval_results/*
!tests/eval/eval_results/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
